<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/fundo_item_compromisso"
    android:padding="16dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/txtItemTitulo"
        android:textColor="@color/laranja_principal"
        android:textSize="18sp"
        android:textStyle="bold"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/txtItemDataHorario"
        android:layout_marginTop="4dp"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/txtItemDescricao"
        android:layout_marginTop="8dp"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/btnItemEditar"
            android:layout_weight="1"
            android:backgroundTint="@color/laranja_secundario"
            android:text="@string/acao_editar"
            android:textColor="@color/white"/>
        <Space
            android:layout_width="8dp"
            android:layout_height="1dp"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/btnItemExcluir"
            android:textColor="@color/white"
            android:backgroundTint="@color/vermelho"
            android:text="@string/acao_excluir"/>
    </LinearLayout>

</LinearLayout>