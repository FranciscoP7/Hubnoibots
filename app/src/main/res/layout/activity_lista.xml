<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_tela"
    android:padding="@dimen/margem_tela"
    >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="26dp"
        android:textStyle="bold"
        android:textColor="@color/laranja_principal"
        android:text="@string/titulo_agenda"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/btnNovoNaLista"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/laranja_secundario"
        android:text="@string/botao_novo"
        android:textColor="@color/white"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/txtListaVazia"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/lista_vazia"
        android:textColor="@color/texto_secundario"
        android:textSize="16sp"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/recyclerCompromisso"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:visibility="gone"
        />



</LinearLayout>